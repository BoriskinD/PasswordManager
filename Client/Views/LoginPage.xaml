<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"       
             x:Class="Client.Views.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout>
        <Entry Placeholder="Логин" Margin="5"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               Text="{Binding UserLogin}"/>

        <Entry Placeholder="Пароль" Margin="5"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               IsPassword="{Binding IsEntryPassword}"
               Text="{Binding UserPassword}"/>

        <HorizontalStackLayout HorizontalOptions="Center">
            <CheckBox IsChecked="{Binding IsShowPassword}"/>
            <Label Text="Показать пароль" Margin="0,10,0,0"
                   FontSize="15"/>            
        </HorizontalStackLayout>
        

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Text ="Войти"
                    HorizontalOptions="End" VerticalOptions="Center"
                    Margin="0,0,10,0" WidthRequest="175"
                    BackgroundColor="#69d2e7" HeightRequest="20"
                    Command="{Binding LoginCommand}"/>

            <Button Grid.Column="1" Text="Зарегистрироваться"
                    HorizontalOptions="Start" VerticalOptions="Center"
                    WidthRequest="175" BackgroundColor="#69d2e7"
                    HeightRequest="20"
                    Command ="{Binding RegisterCommand}"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>